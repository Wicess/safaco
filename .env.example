# ── Neon Postgres ─────────────────────────────────────────────
# Pooled URL (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Direct URL — used only by `prisma migrate deploy`.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# ── Brevo (transactional email) ───────────────────────────────
BREVO_API_KEY=""
# Verified sender on the authenticated domain
MAIL_FROM="site@your-domain.cm"
# Where leads are delivered (per division; DEFAULT is the fallback)
LEADS_TO_DEFAULT="contact@your-domain.cm"
LEADS_TO_CONSTRUCTION=""
LEADS_TO_APARTMENTS=""
LEADS_TO_DESIGNS=""

# ── Cloudflare ────────────────────────────────────────────────
# Turnstile (form anti-spam). Site key is public (VITE_ = exposed to the browser).
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Optional: reject tokens issued for another hostname
TURNSTILE_HOSTNAME="your-domain.cm"
# Web Analytics beacon token (free, cookieless). Leave empty to disable.
VITE_CF_BEACON_TOKEN=""

# ── Build ─────────────────────────────────────────────────────
# Set to 1 on the production launch build to fail while CLIENT_TODO placeholders remain.
STRICT_CONTENT="0"
