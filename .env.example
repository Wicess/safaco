# ── Neon Postgres ─────────────────────────────────────────────
# Pooled URL (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Direct URL — used only by `prisma migrate deploy`.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# How enquiries are stored. Neon bills by time AWAKE (sleeps after 5 min idle).
#   always   = every enquiry → one INSERT (durable record incl. visitor location)  [default]
#   fallback = write only when the email could NOT be sent (DB stays asleep normally)
#   off      = never write (email only)
LEAD_STORE="always"

# ── Email (plain SMTP via the domain mailbox) ─────────────────
# Hostinger: smtp.hostinger.com, 465 (SSL). Most hosts only let you send AS SMTP_USER.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="sales@safaandcosarl.com"
SMTP_PASS=""
MAIL_FROM="sales@safaandcosarl.com"
# Where leads are delivered (per division; DEFAULT is the fallback)
LEADS_TO_DEFAULT="contact@safaandcosarl.com"
LEADS_TO_CONSTRUCTION=""
LEADS_TO_APARTMENTS=""
LEADS_TO_DESIGNS=""

# ── Cloudflare ────────────────────────────────────────────────
# Turnstile (form anti-spam). Site key is public (VITE_ = exposed to the browser).
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Optional: reject tokens issued for another hostname
TURNSTILE_HOSTNAME="safaandcosarl.com"
# Web Analytics beacon token (free, cookieless). Leave empty to disable.
VITE_CF_BEACON_TOKEN=""

# R2 media (pnpm media:upload). Public base URL for images, e.g. https://media.safaandcosarl.com/media
# (r2.dev URLs are for development — use a custom domain in production). Empty = serve from Vercel.
R2_BUCKET="sako"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
VITE_MEDIA_BASE=""

# ── Build ─────────────────────────────────────────────────────
# Set to 1 on the production launch build to fail while CLIENT_TODO placeholders remain.
STRICT_CONTENT="0"

# ── Admin panel (/admin) ──────────────────────────────────────
# Signs the admin login cookie. Any long random string: `openssl rand -base64 48`.
SESSION_SECRET=""
# Public URL of the R2 bucket (no trailing /media). The build step checks it for
# a pending admin publish (scripts/should-build.sh).
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
# Vercel → Project → Settings → Git → Deploy Hooks → create one for "main".
# "Publish" in the admin calls it so the site rebuilds with the new content.
VERCEL_DEPLOY_HOOK_URL=""
# Visit statistics: one database write per visit (not per page). "off" = none.
ANALYTICS_STORE="on"
