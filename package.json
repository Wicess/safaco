{
  "name": "safa-co",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "react-router dev",
    "dev:api": "NODE_OPTIONS=--experimental-websocket tsx watch server/dev.ts",
    "build": "tsx scripts/content-pull.ts && prisma generate && pnpm build:api && react-router build && tsx scripts/postbuild.ts",
    "build:api": "esbuild server/app.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outfile=server/dist/app.mjs --log-level=warning",
    "preview": "tsx scripts/preview.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "media": "tsx scripts/media.ts",
    "media:upload": "tsx scripts/r2-upload.ts",
    "indexnow": "tsx scripts/indexnow.ts",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "postinstall": "node -e \"const f='app/content/overrides.generated.json',fs=require('fs');fs.existsSync(f)||fs.writeFileSync(f,'{}\\n')\" && prisma generate && pnpm build:api",
    "content:pull": "tsx scripts/content-pull.ts",
    "admin:user": "NODE_OPTIONS=--experimental-websocket tsx scripts/admin-user.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-router/node": "^8.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "isbot": "^5.2.2",
    "lucide-react": "^1.48.0",
    "mediabunny": "1.62.1",
    "nodemailer": "^10.3.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "compression": "^1.8.2",
    "dotenv": "^18.0.4",
    "esbuild": "0.28.2",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "sharp",
      "esbuild"
    ]
  }
}
